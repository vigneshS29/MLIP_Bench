# -------------------------------------------------------------------------
# LAMMPS Script: 50x Repeated 3 keV Si Cascades (SW + ZBL)
# Features: Wavy Sinusoidal Surface, ~3nm Z-depth, ~3nm Y-depth, Grazing Angle
# -------------------------------------------------------------------------

# 1. INITIALIZATION
units           metal
dimension       3
boundary        p p f
atom_style      atomic

# 2. SYSTEM GEOMETRY
lattice         diamond 5.431

# Box: X=18 cells (10nm), Y=6 cells (~3.3nm), Z=24 cells (13nm total: ~3nm bulk + 10nm vacuum)
region          simbox block 0 18 0 6 0 24
create_box      1 simbox

# Bulk Si: Z = 0 to 6 cells (32.586 A bulk height)
region          bulk block 0 18 0 6 0 6
create_atoms    1 region bulk
mass            1 28.0855

# -------------------------------------------------------------------------
# SCULPT THE SINUSOIDAL SURFACE
# Mean height: 22.586 A. Amplitude: 10 A. Wavelength: 97.758 A (X-length).
# Peaks are at ~32.5 A, valleys are at ~12.5 A.
# -------------------------------------------------------------------------
variable        PI equal 3.14159265
variable        z_wave atom "z > (22.586 + 10.0 * sin(2.0 * v_PI * x / 97.758))"
group           to_delete variable z_wave
delete_atoms    group to_delete

# 3. DEFINE LAYERS
region          bot_layer block INF INF INF INF 0 5 units box
group           fixed_atoms region bot_layer

region          thermo_layer block INF INF INF INF 5 10 units box
group           thermo_atoms region thermo_layer

group           mobile subtract all fixed_atoms
group           nve_atoms subtract mobile thermo_atoms

# 4. INTERATOMIC POTENTIAL (SW + ZBL)
pair_style      hybrid/overlay sw zbl 1.0 1.5
pair_coeff      * * sw Si.sw Si
pair_coeff      * * zbl 14 14

# 5. ENERGY MINIMIZATION 
fix             freeze_min fixed_atoms setforce 0.0 0.0 0.0
min_style       cg
minimize        1.0e-8 1.0e-8 5000 10000
unfix           freeze_min

# 6. CONSTRAINTS & EQUILIBRATION
velocity        fixed_atoms set 0.0 0.0 0.0
fix             freeze fixed_atoms setforce 0.0 0.0 0.0

fix             thermostat thermo_atoms nvt temp 300.0 300.0 0.1
fix             dynamics nve_atoms nve

velocity        nve_atoms create 300.0 87287 loop geom
velocity        thermo_atoms create 300.0 12345 loop geom

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          1000
thermo_style    custom step temp pe ke etotal press vol

# Delete sputtered atoms that escape the vacuum
thermo_modify   lost ignore

timestep        0.001 
run             5000

# 7. CASCADE SETTINGS
timestep        0.0001 
# Output trajectory frame every 0.1 ps
dump            1 all custom 1000 dump.lammpstrj id type x y z

# 8. REPEATED BOMBARDMENT LOOP (50 Iterations)
variable        iter loop 50
label           cascade_loop

    # Define the top surface region (capturing the sine wave peaks)
    region          current_surf_reg block INF INF INF INF 20.0 60.0 units box
    group           current_surface region current_surf_reg
    
    # ---------------------------------------------------------------------
    # 2017-COMPATIBLE RANDOM ATOM SELECTION (ID Guessing Micro-Loop)
    # Reduced max random guess to 8000 since the smaller box has fewer atoms
    # ---------------------------------------------------------------------
    variable        pka_id equal round(random(1,8000,${iter}987))
    
    variable        subiter loop 10000
    label           pick_loop
        variable        pka_id_int format pka_id "%.0f"
        
        group           PKA_temp id ${pka_id_int}
        group           PKA intersect PKA_temp current_surface
        
        variable        n_pka equal count(PKA)
        if "${n_pka} == 1" then "jump SELF break_pick"
        
        group           PKA_temp delete
        group           PKA delete
        variable        n_pka delete
        variable        pka_id_int delete
        
        next            subiter
        jump            SELF pick_loop
        
    label           break_pick
    # ---------------------------------------------------------------------
    
    # Apply 3 keV grazing velocity (89 deg from normal) to our selected atom
    velocity        PKA set 1435.55 0.0 -25.06 units box
    
    # Run the cascade for 6 ps (60,000 steps at 0.1 fs)
    run             60000

    print           "========================================================"
    print           "   Implant Step ${iter} of 50 is COMPLETE"
    print           "========================================================"
    
    # Clean up variables and groups for the next cascade iteration
    group           PKA_temp delete
    group           PKA delete
    group           current_surface delete
    region          current_surf_reg delete
    
    variable        subiter delete
    variable        n_pka delete
    variable        pka_id_int delete
    variable        pka_id delete
    
next            iter
jump            SELF cascade_loop

print           "--- 50 Cascade Iterations Complete ---"